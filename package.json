{
  "name": "svg-eslint-parser",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@11.9.0",
  "description": "An SVG parser that produces output compatible with ESLint.",
  "keywords": [
    "eslint-parser",
    "parser",
    "svg"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github.com/ntnyq/svg-eslint-parser#readme",
  "repository": "ntnyq/svg-eslint-parser",
  "bugs": {
    "url": "https://github.com/ntnyq/svg-eslint-parser/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "deploy": "run-s build docs:build",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ntnyq/utils": "^0.16.0",
    "eslint-visitor-keys": "^5.0.1"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.9",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260701.1",
    "@vitest/coverage-v8": "^4.1.9",
    "bumpp": "^11.1.0",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.57.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,yml,yaml,json,toml}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
